#!/bin/sh
# pre-push 钩子：推送前调一次发布闸门（tools/daily_gate.py --check-push）。
#
# 当前设置：每天可推送任意次，闸门总开关
# tools/daily_gate.py 的 ENABLE_DAILY_LIMIT = False，每次都直接放行。
# 钩子仍保留，是为了：① 日期戳照常在 pre-commit 盖上、历史可查；
# ② 想恢复「一天只推一次」时，把那个开关改成 True 即可，钩子不用动。
#
# 这个仓库不用 GitHub Actions（Pages source 设为分支），所以哪怕恢复限制，
# 也只靠本地钩子实现。GitHub Desktop 会执行 git 钩子，钩子失败会阻止推送。
#
# 判定逻辑（仅 ENABLE_DAILY_LIMIT=True 时生效）：
#   1. 查远端 origin/main 最近提交的日期戳 —— 只要有今天的戳就拦
#      （跨机器、跨工具都成立）
#   2. 查本机推送记录 .git/wb-publish-state.json —— 远端还没同步到本地时的兜底
#
# 戳是怎么来的：每次提交由 .githooks/pre-commit 自动盖上，
# 所以不管用 GitHub Desktop 还是命令行，戳都在。

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# 只拦 main 分支；其它分支照常推
case "$BRANCH" in
  main|master) ;;
  *) exit 0 ;;
esac

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
CHECK="$ROOT/tools/daily_gate.py"

# 检查脚本不在（比如精简过的克隆）就放行，不误杀
[ -f "$CHECK" ] || exit 0

for c in python python3 py; do
  if command -v "$c" >/dev/null 2>&1; then
    "$c" "$CHECK" --check-push
    exit $?
  fi
done

echo "提示：找不到 python，跳过每日闸门检查。"
exit 0
