#!/bin/sh
# pre-commit 钩子：给本次提交自动盖上「北京日期」戳。
#
# 为什么需要它：原先日期戳只由 tools/daily_update.py 写入，
# 意味着用 GitHub Desktop 直接点「Commit」的人根本不会更新戳，
# 闸门形同虚设。改成每次提交都自动盖戳后，
# 无论用什么工具提交，戳都会随提交进入 git 历史，远端可查。
#
# 盖完戳会 git add 到暂存区，让它跟着本次提交一起进历史。
# 已经在今天盖过戳就跳过（幂等，不重复改文件）。

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# 只在 main/master 上盖戳，其它分支不打扰
case "$BRANCH" in
  main|master) ;;
  *) exit 0 ;;
esac

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
CHECK="$ROOT/tools/daily_gate.py"

# 检查脚本不在（比如精简过的克隆）就放行，不误杀
[ -f "$CHECK" ] || exit 0

for c in python python3 py; do
  if command -v "$c" >/dev/null 2>&1; then
    "$c" "$CHECK" --stamp-commit
    exit 0
  fi
done

echo "提示：找不到 python，跳过日期戳盖戳。"
exit 0
